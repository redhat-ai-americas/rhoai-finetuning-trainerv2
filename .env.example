# Copy to .env and adjust for your cluster (used by scripts/setup.sh).
# The notebook reads Kubernetes namespace from the workbench pod and MLflow from
# workbench annotations; these values are primarily for manifest deployment.

# Demo namespace (must match your RHOAI Data Science Project namespace)
DEMO_NAMESPACE=osft-banking-support-demo

# RWX storage class from your cluster (e.g. efs-csi on AWS — see openshift-infra)
STORAGE_CLASS=efs-csi

# Shared PVC and ServiceAccounts
DEMO_PVC_NAME=shared-support-data
DEMO_SA_NAME=osft-dist-banking-demo
PVC_SIZE=50Gi

# Workbench ServiceAccount — must match the SA your Jupyter workbench pod runs as.
# Find it with:
#   oc get pod -n <namespace> -l opendatahub.io/dashboard=true \
#     -o jsonpath='{.items[0].spec.serviceAccountName}{"\n"}'
DEMO_WORKBENCH_SA=osft-custom-image

# vLLM model name — must match the name you enter in the RHOAI Deploy Model UI
VLLM_MODEL_NAME=banking-routing-model

# Optional: override the in-cluster vLLM endpoint (auto-derived if unset)
# VLLM_ENDPOINT=http://banking-routing-model-predictor.osft-banking-support-demo.svc.cluster.local/v1

# Optional: set to false only for sandbox clusters with self-signed API certs
# K8S_VERIFY_SSL=true

# Custom workbench image (build from container/Dockerfile)
CUSTOM_IMAGE=quay.io/YOUR_ORG/banking-demo-base:latest
